# Free local development. Never put real credentials in this committed file.
DOCULENS_DATABASE_URL=sqlite:///var/doculens.db
DOCULENS_STORAGE_DIR=var/files
DOCULENS_ADMIN_TOKEN=
DOCULENS_MODEL_BACKEND=sentence_transformer
DOCULENS_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
DOCULENS_EMBEDDING_REVISION=1110a243fdf4706b3f48f1d95db1a4f5529b4d41
DOCULENS_EMBEDDING_DIMENSION=384
DOCULENS_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
DOCULENS_RERANKER_REVISION=233902d25c440f23af6f7d6e94d2946bac0bee0a
DOCULENS_CPU_THREADS=2
DOCULENS_INFERENCE_CONCURRENCY=1
DOCULENS_CHUNK_TOKENS=180
DOCULENS_CHUNK_OVERLAP=32
DOCULENS_UPLOAD_BYTES=10485760
DOCULENS_EXTRACTED_CHARS=2000000
DOCULENS_MAX_CHUNKS=2000
DOCULENS_BM25_K1=1.5
DOCULENS_BM25_B=0.75
DOCULENS_CANDIDATE_LIMIT=20
DOCULENS_RRF_CONSTANT=60
DOCULENS_LEXICAL_WEIGHT=1
DOCULENS_DENSE_WEIGHT=1
DOCULENS_CONTEXT_TOKENS=4096
DOCULENS_CONTEXT_CHUNKS=6
DOCULENS_ANSWER_TOKENS=700
DOCULENS_GENERATION_MODE=disabled
# Optional FREE local Ollama; never use a cloud model tag for the free build.
DOCULENS_PROVIDER_URL=http://127.0.0.1:11434/v1
DOCULENS_PROVIDER_MODEL=qwen2.5:7b-instruct
DOCULENS_PROVIDER_API_KEY=ollama
DOCULENS_PROVIDER_TOKEN_PARAMETER=max_tokens
DOCULENS_PROVIDER_TIMEOUT=120
DOCULENS_PROVIDER_RETRIES=1
DOCULENS_PROVIDER_REPAIR_ATTEMPTS=1
DOCULENS_PROVIDER_OUTPUT_BYTES=20000
DOCULENS_PROVIDER_CONCURRENCY=2
DOCULENS_JOB_LEASE_SECONDS=300
DOCULENS_JOB_ATTEMPTS=3
DOCULENS_TRACE_RETENTION_DAYS=7
DOCULENS_LOG_LEVEL=INFO
